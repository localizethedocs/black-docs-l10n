#: ../../../../CHANGES.md:1097
msgid "Version 23.12.1"
msgstr ""

#: ../../../../CHANGES.md:1101
msgid ""
"Fixed a bug that included dependencies from the `d` extra by default ([#4108]"
"(https://github.com/psf/black/pull/4108))"
msgstr ""

