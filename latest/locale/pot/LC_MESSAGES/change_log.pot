msgstr ""

#: ../../../../CHANGES.md:1030
msgid ""
"Allow empty first lines at the beginning of most blocks ([#3967](https://"
"github.com/psf/black/pull/3967), [#4061](https://github.com/psf/black/pull/"
"4061))"
msgstr ""

#: ../../../../CHANGES.md:1031
msgid ""
"Add parentheses around long type annotations ([#3899](https://github.com/psf/"
"black/pull/3899))"
msgstr ""

#: ../../../../CHANGES.md:1032
msgid ""
"Enforce newline after module docstrings ([#3932](https://github.com/psf/"
"black/pull/3932), [#4028](https://github.com/psf/black/pull/4028))"
msgstr ""

#: ../../../../CHANGES.md:1033
msgid ""
"Fix incorrect magic trailing comma handling in return types ([#3916](https://"
"github.com/psf/black/pull/3916))"
msgstr ""

#: ../../../../CHANGES.md:1034
msgid ""
"Remove blank lines before class docstrings ([#3692](https://github.com/psf/"
"black/pull/3692))"
msgstr ""

#: ../../../../CHANGES.md:1035
msgid ""
"Wrap multiple context managers in parentheses if combined in a single `with` "
